{
	"name": "@clementprevot/pi-busy-session-guard",
	"version": "0.1.1",
	"description": "Pi extension that confirms new, resumed, or forked sessions while work is still running",
	"keywords": [
		"pi-package",
		"pi-extension",
		"session",
		"guard",
		"subagents"
	],
	"license": "MIT",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/clementprevot/pi-busy-session-guard.git"
	},
	"packageManager": "yarn@4.9.2",
	"engines": {
		"node": ">=22.6"
	},
	"files": [
		"index.ts"
	],
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@types/node": "^26.6.3",
		"typescript": "^5.9.0"
	},
	"scripts": {
		"test": "node --test test/*.test.ts",
		"typecheck": "tsc --noEmit"
	},
	"publishConfig": {
		"access": "public"
	}
}
